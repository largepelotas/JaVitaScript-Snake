# Build trees. build-host/ is the Makefile's fast host loop; the CMake host
# build gets its own directory so `make clean` cannot delete a CMake cache.
build-host/
build-cmake-host/
build-vita/

# Headless screenshots and other generated evidence
artifacts/

# Reference clone (fetched by scripts, never modified, never vendored)
reference/

# Editor / OS noise
*.swp
.DS_Store
compile_commands.json
